pipeline {
    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'ECR_REPOSITORY', defaultValue: '<ECR_REPOSITORY_URI>', description: 'Salida ecr_repository_url del stack de Terraform de deployment-cluster')
    }

    environment {
        ECR_REPOSITORY           = "${params.ECR_REPOSITORY}"
        AWS_REGION               = "us-east-1"
        DEVELOPMENT_CLUSTER_NAME = "labeks-development-dev"
        IMAGE_TAG                = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Leer secreto de Vault, build y push a ECR') {
            agent {
                kubernetes {
                    yaml '''
                        apiVersion: v1
                        kind: Pod
                        spec:
                          serviceAccountName: jenkins-ecr-push
                          containers:
                            - name: kaniko
                              image: gcr.io/kaniko-project/executor:debug
                              command: ["/busybox/cat"]
                              tty: true
                              volumeMounts:
                                - name: docker-config
                                  mountPath: /kaniko/.docker
                            - name: awscli
                              image: amazon/aws-cli:2.17.62
                              command: ["cat"]
                              tty: true
                              volumeMounts:
                                - name: docker-config
                                  mountPath: /kaniko/.docker
                          volumes:
                            - name: docker-config
                              emptyDir: {}
                    '''
                }
            }
            steps {
                checkout scm

                script {
                    def vaultSecrets = [
                        [path: 'secret/microservice', engineVersion: 2, secretValues: [
                            [envVar: 'VAULT_SECRET', vaultKey: 'value']
                        ]]
                    ]
                    def vaultConfig = [
                        vaultUrl         : 'http://vault.vault.svc.cluster.local:8200',
                        vaultCredentialId: 'vault-k8s-auth',
                        engineVersion    : 2
                    ]

                    withVault([configuration: vaultConfig, vaultSecrets: vaultSecrets]) {
                        sh 'echo "Secreto leido de Vault, disponible como VAULT_SECRET antes del build"'
                    }

                    container('awscli') {
                        sh '''
                            set -euo pipefail
                            REGISTRY=$(echo "$ECR_REPOSITORY" | cut -d/ -f1)
                            TOKEN=$(aws ecr get-login-password --region "$AWS_REGION")
                            AUTH=$(printf "AWS:%s" "$TOKEN" | base64 -w0)
                            printf '{"auths":{"%s":{"auth":"%s"}}}' "$REGISTRY" "$AUTH" > /kaniko/.docker/config.json
                        '''
                    }

                    container('kaniko') {
                        sh '/kaniko/executor --context=dir://$(pwd)/microservice --dockerfile=Dockerfile --destination=${ECR_REPOSITORY}:${IMAGE_TAG} --cache=false'
                    }
                }
            }
        }

        stage('Deploy a development (con rollback automático)') {
            agent {
                kubernetes {
                    yaml '''
                        apiVersion: v1
                        kind: Pod
                        spec:
                          serviceAccountName: jenkins-deploy
                          containers:
                            - name: awscli
                              image: amazon/aws-cli:2.17.62
                              command: ["cat"]
                              tty: true
                              volumeMounts:
                                - name: kubeconfig
                                  mountPath: /kubeconfig
                            - name: kubectl
                              image: alpine/k8s:1.31.0
                              command: ["cat"]
                              tty: true
                              volumeMounts:
                                - name: kubeconfig
                                  mountPath: /kubeconfig
                          volumes:
                            - name: kubeconfig
                              emptyDir: {}
                    '''
                }
            }
            steps {
                container('awscli') {
                    sh "aws eks update-kubeconfig --name ${DEVELOPMENT_CLUSTER_NAME} --region ${AWS_REGION} --kubeconfig /kubeconfig/config"
                }

                script {
                    try {
                        container('kubectl') {
                            sh "KUBECONFIG=/kubeconfig/config kubectl -n development set image deployment/microservice microservice=${ECR_REPOSITORY}:${IMAGE_TAG}"
                            sh "KUBECONFIG=/kubeconfig/config kubectl -n development rollout status deployment/microservice --timeout=180s"
                        }
                    } catch (err) {
                        echo "Deploy fallo (${err}), haciendo rollback al release anterior"
                        container('kubectl') {
                            sh "KUBECONFIG=/kubeconfig/config kubectl -n development rollout undo deployment/microservice"
                            sh "KUBECONFIG=/kubeconfig/config kubectl -n development rollout status deployment/microservice --timeout=180s"
                        }
                        error "Deploy fallido: se hizo rollback automatico a la version anterior. Revisar logs arriba."
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Deploy de ${ECR_REPOSITORY}:${IMAGE_TAG} exitoso en development."
        }
    }
}
