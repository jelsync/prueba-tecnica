# Copia este archivo a "network.auto.tfvars" (sin ".example") y rellena con los
# IDs reales de tu cuenta de AWS. Terraform carga *.auto.tfvars automáticamente,
# sin necesidad de -var-file. Este archivo real NUNCA se versiona (ver .gitignore)
# porque expone identificadores de una VPC/cuenta real.

existing_vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

# Subredes con ruta directa a un Internet Gateway (para el Load Balancer).
existing_public_subnet_ids = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-xxxxxxxxxxxxxxxxx",
]

# Subredes privadas donde corren los nodos EKS.
existing_private_subnet_ids = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-xxxxxxxxxxxxxxxxx",
]

# Security group de los VPC endpoints existentes (SSM/ECR/STS/logs/...) al
# que hay que darle acceso HTTPS desde el security group del clúster EKS.
shared_vpc_endpoints_sg_id = "sg-xxxxxxxxxxxxxxxxx"
